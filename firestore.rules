rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    //  Task Hub — Reglas de seguridad (v13)
    //
    //  v13 editada 2026-09-26 (panel de expertos v18, especialista de
    //  seguridad/AppSec): `members/{mid}.update` topaba `totalPoints`
    //  (≤100000) y `appreciationGiven` (≤50) desde D10, pero no
    //  `currentStreak`/`bestStreak` — un cliente modificado podía fijar la
    //  racha a cualquier valor vía el mismo PATCH que usa
    //  [MemberRepository.updateMemberStreak], sin pasar por StreakRules.kt
    //  (afecta ranking y desbloqueo de logros de racha). Se añade el mismo
    //  tipo de cota superior (3650 ≈ 10 años de racha diaria).
    //
    //  v12 editada 2026-09-24 (panel de expertos v17, auditoría desde cero,
    //  hallazgo CRÍTICO del especialista de funcionalidad end-to-end).
    //  Dos bugs introducidos sin querer por el "big bang" de v9 (que cerró
    //  `taskHistory`/`rewardRedemptions` a escritura de cliente salvo casos
    //  puntuales), nunca vueltos a probar contra la feature de anonimización
    //  al abandonar/expulsar (añadida 9 días después, panel v14 2026-09-20):
    //
    //   1. `taskHistory/{thid}` tenía `allow update: if false` SIN excepción
    //      — bloqueaba también el PATCH legítimo de
    //      [TaskRepository.anonymizeMemberTaskHistory] que reescribe
    //      `memberId` → el sentinel `"deleted_member"` cuando alguien
    //      abandona/es expulsado de un hogar compartido. Efecto real: esa
    //      anonimización fallaba con 403 el 100% de las veces (el fallo se
    //      tragaba en un best-effort, solo visible como un evento de
    //      analytics) y el UID real de cualquier miembro que se va queda
    //      visible para siempre en el historial de puntos del hogar para el
    //      resto de miembros — contradice la promesa de privacidad
    //      documentada en el propio KDoc de la función. Se añade una rama
    //      que permite ÚNICAMENTE reescribir el campo `memberId` hacia ese
    //      sentinel exacto: a `isTrusted(hid)` (expulsión por admin/owner,
    //      donde el llamador sigue siendo miembro) o a quien sea DUEÑO del
    //      registro (`resource.data.memberId == request.auth.uid`, caso de
    //      abandono voluntario — en `leaveHousehold` el propio documento de
    //      miembro del llamador ya se ha BORRADO antes de llamar a esta
    //      anonimización, así que `isMember(hid)` ya no es cierto en ese
    //      punto y no puede exigirse aquí).
    //   2. Mismo bug, mismo motivo, en `rewardRedemptions/{rrid}`: su
    //      `allow update` solo permitía `isTrusted(hid)`, así que un
    //      miembro `role == "child"` (no admin/owner) que abandona el hogar
    //      por su cuenta nunca podía anonimizar sus propios canjes. Se
    //      añade la misma rama de "dueño del registro reescribiendo
    //      únicamente memberId hacia el sentinel".
    //
    //  Además (hallazgo CRÍTICO del especialista de seguridad/AppSec): las 4
    //  Cloud Functions que mueven `totalPoints` (Admin SDK, saltan estas
    //  reglas por completo) no tenían NINGÚN tope — el tope de 100.000 de
    //  `members/{mid}.update` de más abajo solo protegía la vía de escritura
    //  directa del cliente. Un miembro podía crear una tarea con `points`
    //  arbitrariamente grande (o negativo, para drenar el saldo de OTRO
    //  miembro) y completarla vía la Cloud Function callable para saltarse
    //  el tope por completo. El fix real vive en `functions/src/` (clamp de
    //  `totalPoints` dentro de cada transacción); aquí se añade una segunda
    //  barrera, en el origen: `tasks/{tid}.points` ahora se valida en
    //  `create`/`update` a un rango `[0, 100000]` — cierra también la vía
    //  directa de cliente (crear una tarea con puntos absurdos nunca
    //  pasaba de aquí, pero no estaba explícitamente cerrada) y limita de
    //  qué tamaño puede ser el "material primo" que una Cloud Function
    //  llegue a leer.
    //
    //  v11 editada 2026-09-24 (panel de expertos v16, auditoría desde cero,
    //  hallazgo I4 — Seguridad/AppSec). Antes, `households/{hid}/members/
    //  {mid}/achievements/{achid}` y `households/{hid}/messages/{mid}`
    //  tenían `write` completamente abierto a cualquier miembro del hogar
    //  sobre el documento de CUALQUIER OTRO miembro: un miembro podía
    //  desbloquear logros ajenos arbitrariamente, o editar/borrar mensajes
    //  de chat de otro miembro. Impacto bajo (logros son cosméticos, no
    //  mueven puntos; el chat ya es un espacio de confianza compartida),
    //  pero es la vía de suplantación/vandalismo más laxa de todo el árbol
    //  de reglas. Se restringe: `achievements/{achid}` — `write` solo al
    //  propio dueño (`request.auth.uid == mid`, el propio segmento de ruta
    //  ya es el ID del miembro) o `isTrusted(hid)`; `messages/{mid}` —
    //  `create` se mantiene abierto a cualquier miembro (mandar un mensaje
    //  nuevo), `update`/`delete` se restringen al propio autor
    //  (`resource.data.memberId == request.auth.uid`) o `isTrusted(hid)`,
    //  mismo patrón ya usado en `taskHistory`/`notifications`.
    //
    //  v10 editada 2026-09-12 (tarjeta kanban "[Seguridad] Expulsión del
    //  owner: corregir reglas de sucesión (403)" — decisión de Liberto:
    //  CORREGIR con reglas + deploy, no mantener el bloqueo de UI). Bug: el
    //  `update` de `households/{hid}` solo permitía `isOwner(hid)`, pero
    //  [FirestoreRepository.deleteMember] transfiere `ownerId` al sucesor
    //  (ver [HouseholdRules.planOwnerSuccession]) llamando a
    //  `updateHouseholdOwner` ANTES del soft-delete del owner expulsado — y
    //  quien ejecuta esa expulsión es un ADMIN no-owner (la UI de
    //  `HouseholdMemberList`/`HouseholdScreen` permite a cualquier admin
    //  expulsar a cualquier miembro, incluido el owner). Ese PATCH recibía
    //  403 silencioso (try/catch best-effort) y el hogar se quedaba con
    //  `ownerId` apuntando para siempre al UID ya expulsado. (El caso
    //  "el propio owner abandona voluntariamente" en
    //  [FirestoreRepository.leaveHousehold] YA funcionaba: ahí quien llama
    //  SIGUE siendo el owner vigente en ese instante, así que `isOwner(hid)`
    //  ya lo cubría — esta tarjeta solo cierra el caso de expulsión por un
    //  admin distinto del owner.)
    //
    //  Se añade `isValidOwnerSuccession(hid)`, acotada para no ampliar
    //  permisos de escritura general sobre el hogar:
    //   - solo `isAdminMember(hid)` (admin con cuenta vinculada, no owner —
    //     el propio owner ya tiene su vía con `isOwner(hid)`).
    //   - el diff debe afectar EXCLUSIVAMENTE a `ownerId` (nunca `name`,
    //     `inviteCode`, etc. de paso).
    //   - el nuevo `ownerId` tiene que ser distinto del actual (es una
    //     transferencia, no un no-op).
    //   - el nuevo `ownerId` tiene que ser un miembro REAL de este hogar,
    //     vinculado a una cuenta (`userId == ownerId`, mismo criterio que
    //     [HouseholdRules.resolveOwnerSuccessor]: un perfil "hijo/a" sin
    //     cuenta nunca podría autenticarse como owner) y ACTIVO
    //     (`leftAt == 0`, no un ex-miembro) — nunca un UID arbitrario.
    //  Limitación conocida (aceptada, misma naturaleza que el resto de
    //  "limitaciones arquitectónicas" de este archivo): la regla no puede
    //  verificar que esta transferencia ocurra REALMENTE durante una
    //  expulsión del owner saliente (eso exigiría leer el estado "antes" del
    //  miembro expulsado dentro de la misma regla) — un admin podría en
    //  teoría auto-transferirse la propiedad a sí mismo o a un cómplice sin
    //  que el owner actual esté siendo expulsado de verdad. Aceptado por
    //  decisión de producto: un admin ya es "de confianza" (`isTrusted`)
    //  para gestionar roles y contenido sensible del hogar; esto no reabre
    //  inflación de puntos ni ninguna otra superficie — solo decide quién
    //  es `ownerId`, un campo que ya delega en la confianza entre
    //  owner/admins del mismo hogar.
    //
    //  v9 editada 2026-09-11 (encargo "cliente KMP usa Cloud Functions para
    //  completar tareas + reglas big bang", fase 2b de
    //  docs/recurrencia-backend-cloud-functions-diseno-2026-09-11.md, sección
    //  5 — decisión de Liberto: BIG BANG, no gradual, "sin usuarios reales en
    //  producción no hay versiones viejas en las stores que romper"). El
    //  cliente deja de escribir DIRECTO a Firestore el resultado de
    //  completar/deshacer/reasignar una tarea — esas 4 operaciones
    //  (`completeRecurringTask`/`completeAssignment`/`reassignTaskCompletion`/
    //  `undoTaskCompletion`) pasan por Cloud Functions (`functions/`), que
    //  usan el Admin SDK y por tanto SALTAN estas reglas por completo (no hay
    //  rama especial para ellas abajo — no hace falta, ver nota técnica de la
    //  sección 5 del diseño). Estas reglas ahora solo tienen que CERRAR la
    //  ruta directa del cliente:
    //   - tasks/{tid}: `update` ya no permite tocar
    //     `lastCompletedDate`/`completedBy`/`nextDueAt` bajo NINGUNA rama
    //     (ni siquiera isTrusted/reassignTaskCompletion, que ahora también es
    //     Cloud Function) — el resto de campos (título, puntos, subtareas,
    //     assignmentRotation manual vía updateTask...) sigue editable igual
    //     que antes.
    //   - taskHistory/{thid}: `create`/`update` pasan a `false` sin
    //     excepción — antes cualquier miembro podía crear un registro (lo
    //     hacía `completeTask`/`completeAssignment`) y voltear
    //     `pointsApplied`; ahora solo la función escribe ahí. `read`/`delete`
    //     NO cambian (delete ya no lo usa el cliente tras esta migración,
    //     pero no hace falta cerrarlo explícitamente — fuera de alcance de
    //     este encargo).
    //   - tasks/{tid}/assignments/{aid}: `update` bloquea
    //     `status`/`completedAt`/`pointsAwarded`/`onTime`/`memberId` (las
    //     completaba/reasignaba el cliente antes; ahora solo la función). El
    //     único campo que el cliente sigue actualizando ahí es
    //     `googleEventId` (sync de Calendar, `updateAssignmentGoogleEventId`)
    //     — sigue permitido. `create`/`delete` NO cambian: el cliente sigue
    //     creando asignaciones directo al asignar tareas (`assignTask`/
    //     `replaceAssignments`), eso no tiene problema de atomicidad y queda
    //     fuera de este encargo.
    //   - members/{mid}.totalPoints: SIN CAMBIOS, a propósito. Verificado
    //     contra el código real: la rama `isPeerPointsTransfer` (donar/
    //     agradecer) y la rama "dueño de su propio documento" (con la que el
    //     cliente incrementaba `totalPoints` al completar una tarea) son
    //     ESTRUCTURALMENTE indistinguibles en una regla — ambas son "sube el
    //     totalPoints de un documento de miembro"; la única diferencia es la
    //     intención del caller, que Firestore rules no puede inspeccionar
    //     (limitación ya documentada en la cabecera v8: "sin Cloud Functions
    //     no es posible validar que un incremento se corresponda con una
    //     tarea realmente completada"). Cerrarla aquí rompería también
    //     donar/agradecer. El bloqueo real del incremento por-completar-tarea
    //     es que el CLIENTE YA NO LLAMA a `addMemberPoints` desde
    //     completar/deshacer/reasignar (ver `FirestoreRepository.kt`) — la
    //     Cloud Function lo hace con Admin SDK, saltándose esta regla igual
    //     que el resto. Un cliente viejo sin migrar SÍ podría seguir
    //     incrementando su propio `totalPoints` por esta vía — aceptado
    //     (decisión de Liberto, cero usuarios reales, ver sección 6 del
    //     diseño).
    //
    //  v8 editada 2026-09-12 (ronda de deuda aplicable, punto B7 — decisión
    //  de producto de Liberto: "cualquiera puede donar/agradecer puntos a
    //  cualquier otro miembro, no solo admin/owner"). Antes, el PATCH que
    //  acredita puntos al RECEPTOR en `appreciateMember`/`donatePoints`
    //  (`MemberRepository.addMemberPoints` sobre el documento ajeno) solo lo
    //  permitía `isTrusted(hid)` (owner/admin) — un miembro normal recibía
    //  403 al intentarlo (ver los comentarios "panel de revisión 2026-09-10,
    //  Experto 9" en `MemberRepository.appreciateMember`/`donatePoints`, que
    //  ya manejaban ese 403 con un catch mapeado a TRANSFER_FAILED/
    //  ROLLBACK_FAILED, pero no lo evitaban). Se añade una rama nueva a
    //  `allow update` de `members/{mid}` (ver más abajo) que permite a
    //  CUALQUIER `isMember(hid)` escribir en el documento de OTRO miembro,
    //  acotada para no reabrir inflación de puntos:
    //   - `request.auth.uid != mid`: el receptor no puede auto-acreditarse
    //     (siempre es OTRO miembro quien escribe en su documento).
    //   - `diff().affectedKeys()` debe ser EXACTAMENTE `{'totalPoints'}`:
    //     nunca `role`, `userId`, `appreciationGiven`/`appreciationWeekStart`
    //     (esos son del EMISOR, se escriben en su propio documento bajo la
    //     rama `request.auth.uid == mid` ya existente), `leftAt`, ni ningún
    //     otro campo.
    //   - `totalPoints` solo puede SUBIR (nunca bajar ni resetear el saldo de
    //     otro miembro).
    //   - el incremento de una sola escritura está topado a 1000 (literal en
    //     `isPeerPointsTransfer`, ver la función) — limitación conocida:
    //     estas reglas no pueden verificar ATÓMICAMENTE que este crédito vino
    //     acompañado del débito correspondiente en `donatePoints` (son dos
    //     escrituras HTTP independientes, ver su KDoc de "no atómico"), así
    //     que un cliente modificado podría acreditar puntos sin restárselos a
    //     nadie; el tope por escritura acota el daño de ese escenario en vez
    //     de eliminarlo del todo (eliminarlo requeriría el `:commit`
    //     transaccional ya evaluado y descartado en
    //     docs/atomicidad-commit-pendiente.md).
    //
    //  v8 también incluye (mismo encargo, punto A1 — "completar una tarea sin
    //  otorgar puntos por un fallo parcial no tiene forma de reintentarse"):
    //  `taskHistory/{thid}` gana un nuevo campo `pointsApplied` (ver KDoc de
    //  `TaskHistoryResponse.pointsApplied`) y su `allow update` gana una rama
    //  que permite a CUALQUIER miembro (no solo isTrusted) voltear ESE campo
    //  de `false` a `true` — es el PATCH que hace la compleción NORMAL de
    //  cualquier miembro (`completeTask`/`completeAssignment`) y la
    //  reconciliación automática en `TaskScreenModel.loadTasks`, así que no
    //  puede depender de ser admin/owner (mismo motivo que `create` de
    //  taskHistory, más abajo). Acotada a ESE campo y ESA dirección exacta.
    //
    //  v7 editada 2026-09-04 (encargo "correcciones integridad/seguridad/
    //  privacidad" tras el panel de revisión 2026-09-03/04, Experto 9,
    //  punto 11: "rewardRedemptions/taskHistory sin validar campos en
    //  create"). Añade validación de datos a las dos únicas escrituras de
    //  `create` que quedaban sin restricción de CAMPOS (ya estaban acotadas a
    //  isMember(hid)/isOwner(hid), pero un cliente modificado podía mandar
    //  cualquier `memberId`/`pointsSpent`/`points` vía REST directo):
    //   - taskHistory/{thid} create: `memberId` debe ser un miembro real del
    //     hogar (existsMemberDoc) y `points` no puede ser negativo. NO se
    //     exige `memberId == request.auth.uid`: "cualquier miembro puede
    //     completar cualquier tarea" es un comportamiento de producto ya
    //     existente (ver completeTask/completeAssignment — un padre/madre
    //     completa tareas en nombre de perfiles "hijo/a" sin cuenta propia
    //     desde el mismo dispositivo/sesión), así que esa igualdad
    //     rompería ese flujo real.
    //   - rewardRedemptions/{rrid} create: `memberId` debe ser un miembro
    //     real del hogar, y `pointsSpent` debe coincidir EXACTAMENTE con el
    //     `cost` real de la recompensa referenciada (`rewardId`) en ese
    //     instante — cierra la vía de canjear con menos puntos de los que
    //     cuesta la recompensa manipulando el payload REST.
    //  Limitación conocida (no resuelta aquí, ver "limitación arquitectónica"
    //  más abajo): sigue sin poder validarse que `points`/`pointsSpent`
    //  reflejen una tarea/recompensa concreta correctamente calculada (p.ej.
    //  con penalización aplicada) sin un backend — solo que no sean
    //  negativos / no superen el coste real.
    //
    //  v6 editada 2026-09-02 (encargo "PROPUESTAS panel v4 —
    //  privacidad/seguridad", punto 7: Experto 9 hallazgo #2). Desplegada en
    //  producción el 2026-09-03 23:45:46Z (commit dd60412) vía
    //  scripts/deploy_firestore_rules.py. Ruleset
    //  projects/task-hub-62f98/rulesets/45e73f01-088f-4344-aef0-c97a101938f2
    //  (sustituye al v5 4d5f5625-f24e-40e1-a8b3-954a33715a72) — confirmado
    //  por comparación byte a byte contra firebaserules.googleapis.com en el
    //  panel de expertos 2026-09-03/04 (Expertos 2 y 9).
    //
    //  Cambio v5→v6: la rama de `create` en members/{mid} (tanto
    //  owner/admin como auto-alta por invitación) no validaba
    //  `appreciationGiven`/`appreciationWeekStart`/`leftAt` — un cliente
    //  modificado podía crear ya un miembro con presupuesto de agradecimiento
    //  o antigüedad de semana arbitrarios (saltándose el tope semanal de
    //  [PointsRules.currentAppreciationBudget]), o con `leftAt` != 0 desde el
    //  alta. El cliente real ([MemberRepository.createMember]) siempre manda
    //  appreciationGiven=0/appreciationWeekStart=0 y nunca manda `leftAt` —
    //  ahora la regla lo exige (con default 0 vía get() para el campo que el
    //  cliente no envía).
    //
    //  v5 editada el 2026-09-01 (encargo "privacidad/RGPD + seguridad",
    //  hallazgo M2 del panel de expertos v3 — ver
    //  docs/review-panel-expertos-v3-2026-09-01.md, Experto 9). Desplegada
    //  en producción el 2026-09-01 21:49Z vía scripts/deploy_firestore_rules.py
    //  (PATCH, no POST — ver CLAUDE.md). Ruleset
    //  projects/task-hub-62f98/rulesets/4d5f5625-f24e-40e1-a8b3-954a33715a72
    //  (sustituye al v4 014a2dcd-974a-4dd4-931a-4d8608cdb82c, desplegado 2026-08-31).
    //
    //  Cambio v4→v5 (M2): la rama `isOwner`/`isAdminMember` de `create` en
    //  members/{mid} no validaba los mismos límites que la rama de auto-alta
    //  por invitación — un owner/admin con cliente modificado podía crear un
    //  miembro con `totalPoints`/racha arbitrarios, o con `userId` de OTRA
    //  persona (suplantación). Ahora exige contadores en 0 y que, si se
    //  vincula una cuenta (`userId` no nulo), sea la del propio creador —
    //  cubre los dos usos reales de esta rama (CreateProfileScreen: el
    //  owner crea su propio primer perfil; alta de perfiles "hijo/a" sin
    //  cuenta, con `userId == null`). El rol sigue libre en esta rama a
    //  propósito (owner/admin deben poder fijar/ascender roles).
    //
    //  Historial: v4 se editó como parte del encargo "modelo de roles
    //  seguro" de 2026-08-30 (cierra los 2 bloqueantes de la auditoría
    //  anterior, ver docs/audit-2026-08-30.md) y se completó con el ajuste
    //  de taskHistory delete (propio miembro) del encargo "cierre de
    //  pendientes" 2026-08-31 antes de desplegar.
    //
    //  Ajuste v4 (encargo "cierre de pendientes" 2026-08-31, sección 0):
    //  taskHistory/{thid} `delete` ahora también permite al PROPIO miembro
    //  borrar su registro (memberId == auth.uid), no solo admin/owner.
    //  Motivo: [TaskScreenModel.undoCompleteTask] (deshacer "completar
    //  tarea") lo hace un miembro normal, no un admin — sin este ajuste el
    //  delete (ya best-effort, no rompe el undo) dejaría huérfano para
    //  siempre el registro de taskHistory de cualquier undo hecho por un
    //  miembro no-admin, desincronizando StatsScreen en cuanto se
    //  desplieguen las reglas. `update` de taskHistory sigue restringido a
    //  admin/owner (solo lo usa reassignTaskCompletion, ya gateado en UI).
    //
    //  Cambios respecto a v3 (cierran los 2 bloqueantes que impedían
    //  desplegar v3 — ver "IMPORTANTE" de v3 más abajo):
    //   - members/{mid} (auto-alta con código de invitación): el rol YA
    //     NO es libre. v3 permitía "child" o "admin" porque
    //     JoinHouseholdScreen.kt dejaba elegir; ahora esa pantalla fuerza
    //     "child" siempre (nadie se autoproclama admin al unirse por
    //     código — un admin existente asciende al segundo progenitor
    //     después). Se exige `role == "child"` en la propia regla, no solo
    //     en la UI, para que no se pueda saltar por REST directo.
    //     CreateProfileScreen.kt (crear el PRIMER perfil justo tras crear
    //     el hogar) NO usa esta rama: ese flujo solo es alcanzable siendo
    //     ya `ownerId` del hogar recién creado, así que cae en la rama
    //     `isOwner(hid)` de abajo, que sigue permitiendo elegir rol
    //     libremente (el creador del hogar eligiendo su propio rol).
    //   - households/{hid}/tasks/{tid}: antes cualquier miembro podía
    //     escribir cualquier campo de una tarea, incluido `completedBy`
    //     sin restricción — lo que permitía a un miembro no-admin usar
    //     `reassignTaskCompletion` (REST directo) para robarle a otro
    //     miembro los puntos de una tarea ya completada. Ahora un cambio
    //     de `completedBy` que NO va acompañado de un cambio de
    //     `lastCompletedDate` (la firma de una reasignación: ver
    //     [FirestoreRepository.reassignTaskCompletion], que actualiza
    //     `completedBy` en solitario vía `updateMask`) requiere
    //     admin/owner. Completar una tarea (completeTask) y deshacer un
    //     "hecho" (revertTaskCompletion) SIEMPRE cambian ambos campos a
    //     la vez, así que un miembro normal los sigue pudiendo hacer.
    //
    //  (el resto de esta sección documenta los cambios de v2→v3, aún
    //  vigentes en v4 salvo lo indicado arriba):
    //
    //   - members/{mid}: antes CUALQUIER miembro podía update/delete el
    //     documento de CUALQUIER otro miembro sin restricción de campos,
    //     así que un perfil "child" podía auto-ascenderse a "role: admin"
    //     o forjar su propio totalPoints/streak vía REST directo. Ahora
    //     un miembro normal solo puede tocar SU PROPIO documento y nunca
    //     su campo `role`; cambiar el rol de otro requiere ser admin/owner.
    //   - members/{mid} (auto-alta con código de invitación): antes no
    //     validaba el resto de campos del documento nuevo, permitiendo
    //     unirse con totalPoints arbitrario. Ahora exige contadores en 0
    //     y que `userId` coincida con el UID que se está creando (evita
    //     que alguien se auto-registre suplantando el userId de otro
    //     usuario, lo que confundiría a resolveCurrentMember()/isMember()
    //     del lado del cliente). [en v3 el rol era libre aquí; en v4 se
    //     fuerza a "child" — ver el bloque de cambios v3→v4 más arriba]
    //   - taskHistory/rewards: antes cualquier miembro podía editar/borrar
    //     el historial (rompe la integridad de puntos/estadísticas) o
    //     crear/editar recompensas (la UI ya restringe esto a admin/owner,
    //     pero la regla no lo hacía cumplir). Ahora solo admin/owner puede
    //     modificar/borrar taskHistory y escribir rewards.
    //   - isMember()/isAdminMember(): antes solo comprobaban exists() sobre
    //     el documento del miembro. Como abandonar un hogar es un soft-delete
    //     (leftAt = now, el documento NUNCA se borra — ver
    //     FirestoreRepository.deleteMember), un ex-miembro conservaba acceso
    //     de lectura/escritura completo al hogar del que se fue, para
    //     siempre. Ahora isMember() exige además leftAt == 0 (con default 0
    //     vía get() para no romper a miembros activos creados antes de que
    //     existiera este campo, que no lo tienen).
    //   - notifications/{nid}: antes cualquier miembro podía marcar como
    //     leída o BORRAR las notificaciones de cualquier OTRO miembro (el
    //     campo memberId no se comprobaba). Ahora solo el propio
    //     destinatario (o admin/owner, para poder gestionar notificaciones
    //     de perfiles "hijo/a" sin cuenta propia) puede modificar/borrar.
    //
    //  Limitación arquitectónica conocida (no resuelta aquí): sin Cloud
    //  Functions no es posible validar en la regla que un incremento de
    //  totalPoints se corresponde con una tarea realmente completada —
    //  un miembro podría seguir editando SU PROPIO totalPoints a mano vía
    //  REST directo. Cerrarlo del todo requeriría mover esa escritura a
    //  un backend/Cloud Function. Ver docs/audit-2026-08-30.md.
    //
    //  Los 2 bloqueantes de v3 (`reassignTaskCompletion` sin gatear por rol
    //  y el selector libre de rol "Admin" al unirse) están resueltos en v4
    //  tanto en la UI (TaskDetailScreen/HouseholdMemberList/JoinHouseholdScreen)
    //  como en estas reglas — ver el bloque de cambios v3→v4 más arriba.
    //
    //  Modelo de acceso:
    //   - Todo acceso requiere autenticación (request.auth != null).
    //   - Un usuario puede acceder a un hogar solo si es MIEMBRO
    //     (existe un documento members/{uid}) o PROPIETARIO (ownerId).
    //   - Unirse se hace resolviendo invites/{código} y creando el
    //     documento members/{uid} aportando el código válido.
    //
    //  Requisitos de datos (los cumple el cliente):
    //   - households/{id}.ownerId = UID del creador.
    //   - members/{uid}  → miembros vinculados a una cuenta (id = UID).
    //   - members/{auto} → perfiles "hijo/a" sin cuenta (id automático).
    //   - invites/{código} → { householdId } (mapa código → hogar).
    // ══════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    function householdDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid));
    }

    function isOwner(hid) {
      return signedIn()
        && request.auth.uid == householdDoc(hid).data.ownerId;
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid))
        // leftAt > 0 = abandonó el hogar (soft-delete, el doc nunca se borra
        // — ver FirestoreRepository.deleteMember). get(..., 0) por defecto:
        // los miembros activos creados antes de este campo no lo tienen.
        && myMemberDoc(hid).data.get('leftAt', 0) == 0;
    }

    function myMemberDoc(hid) {
      return get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    // ¿Existe un miembro con este ID en el hogar? (no exige que sea el
    // usuario autenticado — ver v7, taskHistory/rewardRedemptions create).
    function existsMemberDoc(hid, mid) {
      return exists(/databases/$(database)/documents/households/$(hid)/members/$(mid));
    }

    // Miembro con rol "admin" vinculado a una cuenta (distinto del owner).
    function isAdminMember(hid) {
      return isMember(hid) && myMemberDoc(hid).data.role == "admin";
    }

    // "Confía" en owner o admin — son quienes gestionan roles/contenido
    // sensible del hogar en la UI (crear recompensas, cambiar roles, etc.).
    function isTrusted(hid) {
      return isOwner(hid) || isAdminMember(hid);
    }

    // Tope de puntos que una ÚNICA escritura de "donar/agradecer entre
    // iguales" puede acreditar al receptor (ver v8 en la cabecera del
    // archivo) — no es un límite de producto (donatePoints no tiene tope de
    // importe, solo el saldo del donante), es una cota de seguridad: sin
    // ella, un cliente modificado podría llamar directamente al PATCH que
    // acredita puntos sin pasar por el débito correspondiente. Bastante por
    // encima de WEEKLY_APPRECIATION_BUDGET (50, ver PointsRules.kt) para no
    // interferir con donaciones legítimas de saldo acumulado.
    function isPeerPointsTransfer(hid, mid) {
      return isMember(hid)
        && request.auth.uid != mid
        && request.resource.data.diff(resource.data).affectedKeys() == ['totalPoints'].toSet()
        && request.resource.data.totalPoints > resource.data.totalPoints
        && request.resource.data.totalPoints <= resource.data.totalPoints + 1000;
    }

    // Sucesión de ownerId al expulsar al owner (v10, ver cabecera del
    // archivo): un admin no-owner puede transferir SOLO ese campo, y solo
    // hacia un miembro real, vinculado a una cuenta y activo de este hogar.
    function isValidOwnerSuccession(hid) {
      return isAdminMember(hid)
        && request.resource.data.diff(resource.data).affectedKeys() == ['ownerId'].toSet()
        && request.resource.data.ownerId != resource.data.ownerId
        && existsMemberDoc(hid, request.resource.data.ownerId)
        && get(/databases/$(database)/documents/households/$(hid)/members/$(request.resource.data.ownerId)).data.userId
           == request.resource.data.ownerId
        && get(/databases/$(database)/documents/households/$(hid)/members/$(request.resource.data.ownerId)).data.get('leftAt', 0) == 0;
    }

    // ── users/{uid}: solo el propio usuario ────────────────────
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ── invites/{código}: resolubles por código, nunca listables ──
    match /invites/{code} {
      // get por id: el código actúa como secreto compartido fuera de banda
      allow get: if signedIn();
      allow list: if false;
      // crear/borrar: solo el propietario del hogar referenciado
      allow create: if signedIn()
        && request.auth.uid == householdDoc(request.resource.data.householdId).data.ownerId;
      allow delete: if signedIn()
        && request.auth.uid == householdDoc(resource.data.householdId).data.ownerId;
    }

    // ── households/{hid}: metadatos (name, inviteCode, ownerId…) ──
    match /households/{hid} {
      // get por id: necesario para unirse (tras resolver el código)
      // y para leer tu propio hogar. El ID es aleatorio → no enumerable.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      // delete sigue reservado al owner vigente (sin cambios v10) — borrar
      // el hogar es la acción más destructiva, no forma parte de la
      // sucesión. update gana isValidOwnerSuccession (v10, ver cabecera).
      allow update: if isOwner(hid) || isValidOwnerSuccession(hid);
      allow delete: if isOwner(hid);
    }

    // ── members/{mid} ──────────────────────────────────────────
    match /households/{hid}/members/{mid} {
      allow read: if isMember(hid) || isOwner(hid);

      allow create: if signedIn() && (
          // owner/admin (p.ej. CreateProfileScreen: el owner crea su propio
          // primer perfil; alta de perfiles "hijo/a" sin cuenta): el rol
          // sigue libre (deben poder fijar/ascender roles), pero el
          // documento nuevo tampoco puede traer ya saldo/racha inventados
          // ni un `userId` que suplante a otra persona — si se vincula una
          // cuenta, tiene que ser la del propio creador (único caso real
          // hoy; los perfiles "hijo/a" usan userId == null). Ver M2 del
          // panel de seguridad v3 (docs/review-panel-expertos-v3-2026-09-01.md).
          (
            (isOwner(hid) || isAdminMember(hid))
            && request.resource.data.totalPoints == 0
            && request.resource.data.currentStreak == 0
            && request.resource.data.bestStreak == 0
            // Mismo tope que la rama de auto-alta de abajo: sin esto, un
            // owner/admin con cliente modificado podía crear ya un miembro
            // con presupuesto de agradecimiento semanal consumido/manipulado
            // o marcado como "abandonado" desde el alta (panel v4, Experto 9
            // hallazgo #2). get(..., 0): el cliente real nunca manda `leftAt`
            // al crear.
            && request.resource.data.get('appreciationGiven', 0) == 0
            && request.resource.data.get('appreciationWeekStart', 0) == 0
            && request.resource.data.get('leftAt', 0) == 0
            && (
              request.resource.data.get('userId', null) == null
              || request.resource.data.userId == request.auth.uid
            )
          )
          // auto-alta: el UID que se crea aporta el código de invitación
          // válido; se fuerza `userId == request.auth.uid` (nadie puede
          // auto-registrarse suplantando el userId de otro usuario) y
          // contadores en 0 para que nadie pueda entrar ya con saldo/racha
          // inventados. El rol se fuerza a "child" (nombre de display
          // "Miembro" — ver AppStrings, el valor interno NO cambia): nadie
          // se autoproclama admin al unirse por código, un admin/owner
          // existente asciende a quien haga falta después (ver el `update`
          // de más abajo). JoinHouseholdScreen.kt ya no ofrece selector.
          || (request.auth.uid == mid
              && request.resource.data.inviteCode == householdDoc(hid).data.inviteCode
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.role == "child"
              && request.resource.data.totalPoints == 0
              && request.resource.data.currentStreak == 0
              && request.resource.data.bestStreak == 0
              && request.resource.data.get('appreciationGiven', 0) == 0
              && request.resource.data.get('appreciationWeekStart', 0) == 0
              && request.resource.data.get('leftAt', 0) == 0)
        );

      // El dueño del documento (mismo UID) puede actualizar su propio perfil
      // y sus contadores (puntos/rachas/agradecimientos) — así es como el
      // cliente los incrementa hoy sin backend propio — pero NUNCA su
      // `role`: eso solo lo cambia el admin/owner (o el propio abandono,
      // que usa `leftAt` bajo el mismo dueño y tampoco toca `role`).
      // La tercera rama (isPeerPointsTransfer) es "donar/agradecer entre
      // iguales" (v8, ver cabecera del archivo): cualquier miembro puede
      // acreditar puntos a OTRO miembro, acotado a solo `totalPoints`, solo
      // al alza y con un tope por escritura — nunca a admin/owner por sí
      // sola (eso lo sigue cubriendo isTrusted arriba).
      allow update: if (
          isTrusted(hid)
          || (
            request.auth.uid == mid
            && request.resource.data.role == resource.data.role
          )
          || isPeerPointsTransfer(hid, mid)
        )
        // D10 (2026-09-24): tope de saldo — ninguna escritura (ni siquiera de
        // owner/admin) puede dejar totalPoints por encima de 100_000. No es
        // un límite de producto real (nadie debería acercarse ni de lejos),
        // es una cota de seguridad ante bugs de cliente o abuso del canal de
        // "donar/agradecer" (isPeerPointsTransfer solo topa el delta de UNA
        // escritura, +1000, no el saldo acumulado).
        && request.resource.data.get('totalPoints', 0) <= 100000
        // D10: rate-limit básico del presupuesto semanal de agradecimientos —
        // mismo tope que WEEKLY_APPRECIATION_BUDGET en PointsRules.kt (50).
        // Sin esto, el propio dueño del documento podía escribir
        // `appreciationGiven` arbitrariamente alto: el presupuesto semanal
        // hoy solo lo hace respetar el cliente, no las reglas.
        && request.resource.data.get('appreciationGiven', 0) <= 50
        // Panel v18 (seguridad): mismo tipo de cota que `totalPoints`/
        // `appreciationGiven` arriba, aplicada ahora a la racha — antes un
        // cliente modificado podía fijar `currentStreak`/`bestStreak` a
        // cualquier valor vía el mismo PATCH que usa
        // MemberRepository.updateMemberStreak, sin pasar por StreakRules.kt.
        // 3650 ≈ 10 años de racha diaria ininterrumpida, muy por encima de
        // cualquier valor legítimo.
        && request.resource.data.get('currentStreak', 0) <= 3650
        && request.resource.data.get('bestStreak', 0) <= 3650;
      // El propio dueño del documento también puede borrarlo — es la ruta que
      // usa [FirestoreRepository.leaveHousehold] (abandonar hogar / eliminar
      // cuenta) para borrar SU PROPIO miembro. Sin esta cláusula, cualquier
      // miembro con rol "child" (el que fuerza el alta por invitación más
      // arriba) recibía 403 al intentar salir de un hogar compartido o al
      // eliminar su cuenta, y el fallo se tragaba en silencio en el cliente
      // (best-effort) — v4 panel de expertos, Experto 10 hallazgo #1 CRÍTICO.
      allow delete: if isTrusted(hid) || request.auth.uid == mid;
    }

    // ── Contenido del hogar ──────────────────────────────────────
    // Cualquier miembro puede leer/crear/borrar tareas y editar sus campos
    // habituales (título, puntos, subtareas, assignmentRotation manual…)
    // igual que antes. v9 (big bang, ver cabecera): `lastCompletedDate`/
    // `completedBy`/`nextDueAt` ya NO se pueden tocar desde el cliente bajo
    // NINGUNA rama — completar/deshacer/reasignar una tarea pasan
    // enteramente por Cloud Functions (Admin SDK, salta esta regla).
    match /households/{hid}/tasks/{tid} {
      allow read, delete: if isMember(hid) || isOwner(hid);
      // v12: `points` acotado a [0, 100000] — ver cabecera del archivo
      // (hallazgo de seguridad, bypass del tope de totalPoints vía Cloud
      // Function). get(..., 0): por si algún caller no manda el campo.
      allow create: if (isMember(hid) || isOwner(hid))
        && request.resource.data.get('points', 0) >= 0
        && request.resource.data.get('points', 0) <= 100000;
      allow update: if (isMember(hid) || isOwner(hid))
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['lastCompletedDate', 'completedBy', 'nextDueAt'])
        && request.resource.data.get('points', 0) >= 0
        && request.resource.data.get('points', 0) <= 100000;
    }
    // v9 (big bang, ver cabecera): `update` bloquea los campos que antes
    // escribía el cliente al completar/reasignar (`status`/`completedAt`/
    // `pointsAwarded`/`onTime`/`memberId`) — ahora solo la Cloud Function los
    // toca. `googleEventId` (sync de Calendar) sigue editable. `create`/
    // `delete` no cambian: el cliente sigue creando/borrando asignaciones al
    // asignar tareas manualmente.
    match /households/{hid}/tasks/{tid}/assignments/{aid} {
      allow read, create, delete: if isMember(hid) || isOwner(hid);
      allow update: if (isMember(hid) || isOwner(hid))
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['status', 'completedAt', 'pointsAwarded', 'onTime', 'memberId']);
    }
    match /households/{hid}/tasks/{tid}/comments/{cid} {
      allow read, write: if isMember(hid) || isOwner(hid);
    }
    // El historial es el registro de auditoría de puntos/estadísticas. v9
    // (big bang, ver cabecera): `create`/`update` desde el cliente se
    // cierran del todo — antes cualquier miembro podía crear una entrada al
    // completar una tarea (y voltear `pointsApplied`); ahora solo la Cloud
    // Function escribe aquí (Admin SDK, salta esta regla), con
    // `pointsApplied: true` directo dentro de su propia transacción.
    match /households/{hid}/taskHistory/{thid} {
      allow read: if isMember(hid) || isOwner(hid);
      allow create: if false;
      // v12 (ver cabecera del archivo, hallazgo CRÍTICO de funcionalidad):
      // única excepción al `update: if false` de v9 — reescribir
      // ÚNICAMENTE `memberId` hacia el sentinel de anonimización
      // (`"deleted_member"`, ver [FirestoreRepository.ANONYMIZED_MEMBER_ID]).
      // `isTrusted(hid)` cubre la expulsión (el admin que expulsa sigue
      // siendo miembro); `resource.data.memberId == request.auth.uid` cubre
      // el abandono voluntario, donde el propio documento de miembro del
      // llamador ya se ha borrado antes de esta llamada (isMember(hid) ya
      // no es cierto ahí, por eso no se exige).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys() == ['memberId'].toSet()
        && request.resource.data.memberId == 'deleted_member'
        && (isTrusted(hid) || resource.data.memberId == request.auth.uid);
      // delete: sin cambios en v9 — admin/owner puede borrar cualquier
      // registro; el propio miembro puede borrar SU PROPIO registro
      // (memberId == auth.uid). Ya no lo usa el cliente para deshacer
      // (`undoTaskCompletion`, la Cloud Function, borra el registro dentro
      // de su transacción vía Admin SDK) — se deja sin tocar por no estar en
      // el alcance de este encargo (ver cabecera v9); no reabre ningún
      // problema de puntos, borrar un registro no toca `totalPoints`.
      allow delete: if isTrusted(hid)
        || (isMember(hid) && resource.data.memberId == request.auth.uid);
    }
    // Cada notificación va dirigida a un miembro (`memberId`). Lectura/creación
    // amplias (dashboard familiar), pero modificar/borrar la notificación de
    // OTRO miembro se restringe a admin/owner (necesario para gestionar
    // notificaciones de perfiles "hijo/a" sin cuenta propia) o al propio
    // destinatario.
    match /households/{hid}/notifications/{nid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid)
        || (isMember(hid) && resource.data.memberId == request.auth.uid);
    }
    // La UI ya restringe "crear recompensa" a admin/owner (RewardListScreen);
    // la regla ahora lo hace cumplir también a nivel de datos.
    match /households/{hid}/rewards/{rid} {
      allow read: if isMember(hid) || isOwner(hid);
      // v23 (panel de expertos, Seguridad IMPORTANTE): `cost` sin validar
      // permitía a un `isTrusted` crear/editar una recompensa con `cost`
      // negativo — `redeemReward` (Cloud Function) solo comprueba
      // `totalPoints < reward.cost`, que con `cost` negativo es siempre
      // falso, así que el "canje" incrementaba `totalPoints` del miembro
      // objetivo sin pasar por ningún tope de los que sí protegen
      // `donatePoints`/`appreciateMember`. Mismo rango que `tasks/{tid}.points`,
      // pero exigiendo estrictamente positivo (la UI ya invalida cost <= 0,
      // ver CreateRewardScreen.kt).
      allow delete: if isTrusted(hid);
      allow create, update: if isTrusted(hid)
        && request.resource.data.get('cost', 0) > 0
        && request.resource.data.get('cost', 0) <= 100000;
    }
    match /households/{hid}/rewardRedemptions/{rrid} {
      allow read: if isMember(hid) || isOwner(hid);
      // v7: memberId debe ser un miembro real del hogar y pointsSpent debe
      // coincidir con el cost real de la recompensa referenciada — ver
      // cabecera del archivo (Experto 9, punto 11).
      allow create: if (isMember(hid) || isOwner(hid))
        && existsMemberDoc(hid, request.resource.data.memberId)
        && request.resource.data.pointsSpent
           == get(/databases/$(database)/documents/households/$(hid)/rewards/$(request.resource.data.rewardId)).data.cost;
      // v12 (ver cabecera del archivo): misma excepción de anonimización
      // que taskHistory — reescribir ÚNICAMENTE memberId hacia el sentinel,
      // por isTrusted (expulsión) o por el propio dueño del registro
      // (abandono voluntario, ya no isMember en ese punto).
      allow update: if isTrusted(hid)
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys() == ['memberId'].toSet()
          && request.resource.data.memberId == 'deleted_member'
          && resource.data.memberId == request.auth.uid
        );
      allow delete: if isTrusted(hid);
    }
    // Panel v16 (2026-09-24, hallazgo I4): antes, `write` estaba abierto a
    // cualquier miembro del hogar sobre el documento `_meta` de CUALQUIER
    // otro miembro — permitía desbloquear logros ajenos arbitrariamente.
    // `{mid}` ya es el propio ID del miembro dueño de la subcolección (no
    // hace falta comparar contra un campo `memberId`, a diferencia de
    // `taskHistory`/`notifications`).
    match /households/{hid}/members/{mid}/achievements/{achid} {
      allow read: if isMember(hid) || isOwner(hid);
      allow write: if isTrusted(hid) || request.auth.uid == mid;
    }
    // Panel v16, hallazgo I4: antes, `write` estaba abierto a cualquier
    // miembro sobre el mensaje de CUALQUIER otro miembro — permitía
    // editar/borrar mensajes de chat ajenos. `create` sigue abierto a
    // cualquier miembro (mandar un mensaje nuevo); `update`/`delete` se
    // restringen al propio autor (`memberId`) o a `isTrusted`, mismo patrón
    // que `taskHistory`/`notifications`.
    match /households/{hid}/messages/{mid} {
      allow read, create: if isMember(hid) || isOwner(hid);
      allow update, delete: if isTrusted(hid) || (isMember(hid) && resource.data.memberId == request.auth.uid);
    }

    // Denegación por defecto: no hay un `match /{document=**}` de cierre.
    // Firestore deniega implícitamente cualquier operación sobre una ruta
    // que no case con ninguno de los `match` de arriba (no hace falta un
    // `allow ...: if false` explícito para ello) — así que colecciones
    // futuras sin regla propia quedan cerradas por defecto en vez de
    // abiertas por omisión.
  }
}
