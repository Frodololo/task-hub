{
  "name": "functions",
  "version": "1.0.0",
  "description": "Task Hub — Cloud Functions (recurrencia de tareas)",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:integration:run": "node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.mjs --runInBand",
    "test:integration": "firebase emulators:exec --only firestore --project demo-task-hub \"npm run test:integration:run\"",
    "test:all": "npm test && npm run test:integration"
  },
  "license": "ISC",
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "firebase-tools": "^15.25.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
